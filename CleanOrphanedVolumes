#!/usr/bin/env bash
# CleanOrphanedVolumes - backward-compatible wrapper for 'roustabout clean-volumes'
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/roustabout" ]; then
    exec "$SCRIPT_DIR/roustabout" clean-volumes "$@"
else
    exec roustabout clean-volumes "$@"
fi
