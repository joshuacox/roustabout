#!/usr/bin/env bash
# createOpenVPNdockercreds - backward-compatible wrapper for 'roustabout openvpn-creds'
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -x "$SCRIPT_DIR/roustabout" ]; then
    exec "$SCRIPT_DIR/roustabout" openvpn-creds "$@"
else
    exec roustabout openvpn-creds "$@"
fi
